    "refresh": "",
    "panels": [
      {
        "id": 1,
        "title": "Total Trips",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "datasource": {
          "type": "trino-datasource",
          "uid": "nyc_taxi_trino"
        },
        "targets": [
          {
            "refId": "A",
            "format": 0,
            "rawSQL": "SELECT SUM(trip_cnt) AS total_trips FROM iceberg.taxi_dw.ads_taxi_daily_overview"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          },
          "overrides": []
        },
        "options": {}
      },
      {
        "id": 2,
        "title": "Total Amount",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "datasource": {
          "type": "trino-datasource",
          "uid": "nyc_taxi_trino"
        },
        "targets": [
          {
            "refId": "A",
            "format": 0,
            "rawSQL": "SELECT ROUND(SUM(total_amount),2) AS total_amount FROM iceberg.taxi_dw.ads_taxi_daily_overview"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          },
          "overrides": []
        },
        "options": {}
      },
      {
        "id": 3,
        "title": "Avg Amount",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "datasource": {
          "type": "trino-datasource",
          "uid": "nyc_taxi_trino"
        },
        "targets": [
          {
            "refId": "A",
            "format": 0,
            "rawSQL": "SELECT ROUND(SUM(total_amount)/SUM(trip_cnt),2) AS avg_amount FROM iceberg.taxi_dw.ads_taxi_daily_overview"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD"
          },
          "overrides": []
        },
        "options": {}
      },
      {
        "id": 4,
